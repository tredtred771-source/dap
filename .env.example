# GEMINI_API_KEY: مفتاح Google Gemini API المجاني بالكامل من Google AI Studio
# احصل عليه مجاناً بدون بطاقة ائتمان من: https://aistudio.google.com
# باقة مجانية تمنحك حتى 1,500 طلب/يومياً (تكفي لأكثر من 5 ساعات من المحادثة اليومية المتواصلة)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: عنوان رابط التطبيق (يتم تحديده تلقائياً أو محلياً)
APP_URL="http://localhost:3000"
